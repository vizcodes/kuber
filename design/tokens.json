{
  "name": "Ledger \u2014 dark finance UI",
  "color": {
    "surface": {
      "canvas": "#0A0A0B",
      "card": "#141416",
      "raised": "#1C1C1F",
      "track": "#1F1F22"
    },
    "border": {
      "hairline": "#242426",
      "subtle": "#1E1E20",
      "row": "#18181A"
    },
    "text": {
      "primary": "#F5F4F1",
      "secondary": "#8C8C87",
      "tertiary": "#6E6E6A",
      "muted": "#5A5A57",
      "dim": "#4A4A48",
      "inverse": "#0A0A0B"
    },
    "flow": {
      "income": "#5DCAA5",
      "expense": "#F0997B",
      "savings": "#5DCAA5",
      "investment": "#AFA9EC",
      "unallocated": "#8C8C87"
    },
    "category": {
      "housing": "#AFA9EC",
      "food": "#F0997B",
      "transport": "#85B7EB",
      "leisure": "#5DCAA5",
      "shopping": "#EF9F27",
      "over_budget": "#E24B4A"
    },
    "source": {
      "salary": "#85B7EB",
      "freelance": "#378ADD",
      "dividends": "#B5D4F4"
    },
    "tint": {
      "teal": "#04342C",
      "coral": "#712B13",
      "purple": "#26215C",
      "blue": "#042C53",
      "amber": "#412402",
      "red": "#501313",
      "gray": "#2C2C2A"
    }
  },
  "typography": {
    "family": "SF Pro Display / SF Pro Text",
    "weights": [
      400,
      500
    ],
    "scale": {
      "hero": 46,
      "title": 28,
      "metric": 27,
      "heading": 18,
      "body": 14,
      "label": 13,
      "caption": 12,
      "micro": 11
    },
    "tracking": {
      "hero": "-0.03em",
      "title": "-0.02em",
      "body": "-0.018em"
    },
    "numerals": "tabular-nums on all currency values"
  },
  "radius": {
    "frame": 0,
    "card": 16,
    "tile": 14,
    "control": 12,
    "chip": 9,
    "bar": "pill"
  },
  "spacing": {
    "page_pad": 40,
    "card_pad": 24,
    "grid_gap": 17,
    "row_height": 54,
    "sidebar": 240
  },
  "frames": {
    "desktop": "1440x900",
    "mobile": "390x844"
  },
  "rules": [
    "Colour only encodes meaning: teal = money in, coral = money out, red = over budget.",
    "Two font weights only, 400 and 500.",
    "Cents are dimmed, never dropped.",
    "Every currency value uses tabular figures so columns align.",
    "Budget bars cap at 100% and turn red rather than overflowing.",
    "Sankey ribbon height is strictly proportional to amount; one scale for both sides."
  ]
}